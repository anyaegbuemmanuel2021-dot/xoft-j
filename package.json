{
  "name": "xoft-ai-core",
  "version": "0.11.1",
  "description": "XOFT — provider-agnostic personal AI assistant with missions, tools, device runtime, voice, memory and AI gateways.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:pc": "node start-pc.cjs",
    "dev": "node --watch src/index.js",
    "xoft": "node scripts/xoft.mjs",
    "test": "node --test",
    "typecheck:shared": "pnpm --filter @xoft/protocol typecheck",
    "build:mobile": "pnpm --dir apps/mobile run typecheck",
    "build:desktop": "pnpm --dir apps/desktop run build",
    "universal:check": "pnpm run typecheck:shared && pnpm run build:mobile && pnpm run build:desktop",
    "verify:deps": "node scripts/dependency-doctor.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  },
  "productName": "XOFT",
  "bin": {
    "xoft": "scripts/xoft.mjs"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
