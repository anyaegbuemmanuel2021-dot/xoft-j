# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# Use a long random token to protect the API. Required automatically in production.
AUTH_TOKEN=

# Configure at least one provider. Keys stay server-side.
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint URL, including /chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Set true only when behind a trusted reverse proxy.
TRUST_PROXY=false

# WhatsApp/email/calendar/device actions are not implemented in this starter version.
