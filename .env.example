NODE_ENV=production
HOST=0.0.0.0
PORT=3000
STORAGE_MODE=sqlite
SQLITE_PATH=./data/xoft.sqlite
REQUIRE_AUTH_IN_PRODUCTION=true
AUTH_API_KEYS=REPLACE_WITH_LONG_RANDOM_SECRET
MEMORY_DATA_DIR=./data
DEVICE_ONLINE_THRESHOLD_MS=90000
DEVICE_COMMAND_TIMEOUT_MS=30000
AUTO_TRUST_LOCAL=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
XAI_API_KEY=
XAI_MODEL=grok-4

# Experiential Labs: OpenAI-compatible multi-model gateway.
# One key can call the models available to your organization. With FREE_ONLY=true,
# XOFT uses free-tier lanes only and will not intentionally switch to paid credits.
EXPERIENTIAL_API_KEY=
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1
EXPERIENTIAL_MODEL=gpt-5.6-luna
EXPERIENTIAL_FREE_ONLY=true

# Optional: pin one provider first for EVERY task type instead of the
# router's default task-aware ordering (see ProviderRouter._preferenceFor).
# Leave AI_PRIMARY_PROVIDER unset to keep the default behavior. Values:
# openai, gemini, claude, grok, experiential, litellm, freellmapi, ollama.
AI_PRIMARY_PROVIDER=
# Only used when AI_PRIMARY_PROVIDER is set. Comma-separated, tried in order
# after the primary. If AI_FALLBACK_ENABLED=false, no cloud fallback is used
# at all — only the primary provider (Ollama, if separately enabled below,
# is still available as the last resort either way).
AI_FALLBACK_PROVIDERS=
AI_FALLBACK_ENABLED=true

# Local model fallback (real offline AI). Requires Ollama installed and running
# on this machine (https://ollama.com) with the model already pulled, e.g.
# `ollama pull llama3.1`. When enabled it is tried LAST, after every configured
# cloud provider fails or when none are configured at all — so XOFT keeps
# answering with zero internet, just with a weaker local model.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BRAVE_SEARCH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
IMAGE_MODEL=gpt-image-2
VIDEO_MODEL=veo-3.1-generate-preview

# External connectors. JSON array of explicitly trusted endpoints. Keep secrets in
# headers, never in source control. Example shape (replace with your real endpoint):
# XOFT_CONNECTORS_JSON=[{"id":"canva","name":"Canva","transport":"mcp-http","endpoint":"https://YOUR-CANVA-MCP-ENDPOINT","headers":{"Authorization":"Bearer YOUR_TOKEN"},"permissions":["connectors.use"],"riskLevel":2}]
XOFT_CONNECTORS_JSON=[]

# Communication integrations (optional; official providers only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PUBLIC_BASE_URL=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_RESPONSE_URL=
TWILIO_STATUS_CALLBACK_URL=

# Maximum wall-clock duration for one XOFT task execution (15 minutes default)
TASK_MAX_DURATION_MS=900000

# ---- Optional AI gateways (all OFF by default; Xoft starts and runs without them) ----
# Xoft does NOT require FreeLLMAPI, LiteLLM, or any single AI provider or API key.
# Each gateway is independent: enable one, both, or neither. Values can also be set in Settings -> AI providers
# (saved to data/provider-settings.json with owner-only permissions; they override these).
# FreeLLMAPI: https://github.com/tashfeenahmed/freellmapi  (needs the unified key from its dashboard)
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=auto            # auto | auto:fast | auto:smart | a concrete model id
# LiteLLM proxy: https://docs.litellm.ai/docs/simple_proxy  (key optional if your proxy has no master key)
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
# LITELLM_MODEL=                   # a model_name from your LiteLLM config.yaml (blank = first model the proxy lists)
# Optional per-gateway tuning (same names with the LITELLM_ prefix):
# FREELLMAPI_EMBEDDING_MODEL=      # set to use this gateway for semantic-memory embeddings when OpenAI is not configured
# FREELLMAPI_VISION=false          # true only if the configured model accepts images
# FREELLMAPI_TOOLS=true            # false if the model cannot do tool calling
# FREELLMAPI_TIMEOUT_MS=60000
# Routing: gateways rank AFTER direct providers by default. To prefer one:
#   AI_PRIMARY_PROVIDER=freellmapi   AI_FALLBACK_PROVIDERS=litellm,openai,claude

# ---- Hosting / operations (all optional) ----
# Behind a reverse proxy (Caddy, Nginx, Cloudflare Tunnel, a PaaS router): number of proxy hops to trust so rate limits and logs
# see the real client IP. Use 1 for a single proxy. Leave empty when Xoft is exposed directly. ("true" is deliberately not accepted.)
TRUST_PROXY=
# How many background tasks run at once.
TASK_QUEUE_CONCURRENCY=2
# Route sensitive content to local models only (needs Ollama). Secrets are then never sent to any cloud provider or gateway.
PRIVACY_ROUTING=false

# ---- Execution engines + Hermes Agent (all optional) ----
# Xoft always has its own engine ("Xoft Core"). Hermes (Nous Research) is an OPTIONAL extra engine for long-running autonomous
# work (coding, terminal, multi-step tasks). Without it, nothing changes: tasks use Xoft Core. Full guide: docs/HERMES_ENGINE.md
ENGINES_MAX_CONCURRENT_TASKS=3         # engine tasks running at once, across all engines
ENGINES_RESUME_ON_STARTUP=true         # re-attach to / restart unfinished engine tasks after a Xoft restart
ENGINES_HEALTH_INTERVAL_MS=30000       # how often engine health is re-checked
ENGINES_GIT_SAFETY_NET=true            # record a git baseline/backup ref before an agent edits a repository
HERMES_ENABLED=true
HERMES_AUTO_START=false                # true = Xoft starts `hermes gateway` itself (only if Hermes is already installed)
HERMES_API_URL=http://127.0.0.1:8642   # Hermes' API server (Hermes: API_SERVER_ENABLED=true, API_SERVER_KEY=...)
HERMES_API_KEY=                        # the SAME secret as Hermes' API_SERVER_KEY (leave empty if Xoft starts Hermes: it generates one)
# HERMES_COMMAND=                      # path to the hermes executable (default: found on PATH)
# HERMES_HOME=                         # Hermes' data dir (default ~/.hermes, or %LOCALAPPDATA%\hermes on native Windows)
# HERMES_WORKING_DIRECTORY=            # default project folder for coding/file tasks
# HERMES_ALLOWED_ROOTS=                # comma-separated; Hermes tasks may only run inside these (blank = any non-system project folder)
HERMES_DEFAULT_AUTONOMY=2              # 0-5 (Xoft's global autonomy level is always a ceiling)
HERMES_PERMISSION_PROFILE=standard     # observe | standard | developer | full  — the ceiling for every Hermes task
HERMES_MAX_CONCURRENT_TASKS=2
HERMES_TASK_TIMEOUT_MS=3600000
HERMES_MAX_TOOL_CALLS=500              # 0 = unlimited
HERMES_MAX_RETRIES=2                   # recovery attempts after an engine crash
# HERMES_MAX_MEMORY_MB=0               # 0 = unlimited (enforced on a Hermes that Xoft started, Linux/macOS)
HERMES_NATIVE_TOOL_POLICY=monitor      # monitor | enforce | off — how Hermes' OWN tools are checked against the permission profile
HERMES_WORKSPACE_MODE=in-place         # in-place | branch | worktree — git safety net for code changes
HERMES_BRIDGE_ENABLED=true             # let Hermes use Xoft's tools through Xoft's permission system (MCP, loopback + token)
# HERMES_BRIDGE_DEVICE_ID=             # which paired device the bridged tools act on (blank = first online trusted device)
# HERMES_BRIDGE_ALLOW_REMOTE=false     # keep false unless Hermes runs on another machine
# HERMES_MODEL=  HERMES_PROVIDER=      # optional per-run model override passed to Hermes


# --- Addressing ---
# XOFT is a male persona and addresses the speaker as "sir" or "ma'am" (learned from what they say,
# or set via POST /api/address). No env variable needed; data is stored with the rest in MEMORY_DATA_DIR.
